+module RedmineCustomWorkflows
+  # Per request or job state. Rails resets it between requests and jobs.
+  class Current < ActiveSupport::CurrentAttributes
+    # { at: monotonic seconds, list: observables with an active workflow }, see CustomWorkflow.active_observable?
